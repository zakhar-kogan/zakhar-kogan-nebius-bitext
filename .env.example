NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
ROUTER_MODEL=nvidia/Nemotron-3-Nano-Omni
MAIN_MODEL=MiniMaxAI/MiniMax-M2.5-fast
RECOMMENDER_MODEL=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=bitext-data-analyst-agent

DATASET_PATH=data/raw/bitext_customer_support.csv
CHECKPOINT_DB_PATH=data/state/checkpoints.sqlite
APP_DB_PATH=data/state/app.sqlite

MAX_AGENT_ITERATIONS=12
MEMORY_DISTILLATION_MODE=per_conversation
MEMORY_DISTILLATION_TURN_INTERVAL=3
SESSION_COMPACTION_TURN_THRESHOLD=16
SESSION_RECENT_TURN_LIMIT=12

LOG_LEVEL=INFO
